<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Extra Info.plist keys merged into the macOS bundle by Tauri.

  NSMicrophoneUsageDescription is what macOS shows the first time push-to-talk
  opens the mic. It is not optional: without it the system terminates the app
  the moment getUserMedia asks for audio, rather than showing a prompt. Pairs
  with com.apple.security.device.audio-input in entitlements.plist.

  The three folder descriptions are what macOS shows when Infinite Brain first touches
  Documents (the default vaults root, Documents/Infinite Brain Vaults), Desktop or
  Downloads (only ever a vault folder the user picked there).
-->
<plist version="1.0">
<dict>
    <key>NSLocalNetworkUsageDescription</key>
    <string>같은 회사 네트워크에서 공유 중인 작업 공간을 찾거나, 직접 켠 사내 공유를 알리는 데 사용해요. Infinite Brain finds shared workspaces on your company network and advertises sharing only when you turn it on.</string>
    <key>NSBonjourServices</key>
    <array><string>_ib-office._tcp</string></array>
    <key>NSMicrophoneUsageDescription</key>
    <string>Infinite Brain uses your microphone only while you hold the talk button, to broadcast live audio to your vault. Nothing is recorded or stored.</string>
    <key>NSDocumentsFolderUsageDescription</key>
    <string>Infinite Brain keeps your vaults in Documents/Infinite Brain Vaults.</string>
    <key>NSDesktopFolderUsageDescription</key>
    <string>Infinite Brain only reads a vault folder you choose here.</string>
    <key>NSDownloadsFolderUsageDescription</key>
    <string>Infinite Brain only reads a vault folder you choose here.</string>
</dict>
</plist>
